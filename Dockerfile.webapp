# syntax=docker/dockerfile:1
# ============================================================
# AMC webapp — couche navigateur ajoutée à l'image AMC existante
#
# Base : amc-nqcm:latest (construite par le Dockerfile principal)
#        → fournit AMC (PPA test) + TeX Live 2026 + classe nQCM.
# Ajoute : le serveur Flask officiel amc-webapp, servi par gunicorn.
# ============================================================

FROM amc-nqcm:latest

# Révision pinnée du dépôt amc-webapp (reproductibilité)
ARG AMC_WEBAPP_REV=8b9f70ae07fe3dd6eb2f4b9c633a8b73bea46f3a
ARG AMC_WEBAPP_REPO=https://gitlab.com/auto-multiple-choice/amc-webapp.git

ENV DEBIAN_FRONTEND=noninteractive

# ── 1. Dépendances Python (+ uglifyjs pour les assets ACE) ───
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 \
      python3-venv \
      python3-dev \
      python3-pip \
      build-essential \
      libcups2-dev \
      uglifyjs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── 2. Source du serveur webapp ──────────────────────────────
RUN git clone "$AMC_WEBAPP_REPO" /tmp/amc-webapp \
    && git -C /tmp/amc-webapp checkout "$AMC_WEBAPP_REV" \
    && rm -rf /tmp/amc-webapp/.git

# ── 3. Environnement Python du serveur ───────────────────────
RUN python3 -m venv /venv \
    && /venv/bin/pip install --no-cache-dir -U pip \
    && /venv/bin/pip install --no-cache-dir -r /tmp/amc-webapp/requirements.txt \
    && /venv/bin/pip install --no-cache-dir gunicorn

# ── 4. Installation du serveur (translations, ACE, icônes) ───
RUN mkdir -p /amc-web \
    && cp -a /tmp/amc-webapp/server /amc-web/ \
    && cp -a /tmp/amc-webapp/src-icons /amc-web/ \
    && cp /tmp/amc-webapp/Makefile /amc-web/ \
    && rm -rf /tmp/amc-webapp

# Version affichée dans l'interface (dépôt cloné sans .git → on l'écrit ici)
RUN printf 'APP_VERSION="%s"\n' "$AMC_WEBAPP_REV" > /amc-web/server/version.py

# ── 4b. Surcharges locales de la GUI (voir webapp/README.md) ─
# Copiées après le clone : tout fichier présent écrase l'original.
COPY webapp/overrides/ /amc-web/

# ── 4c. Traductions de l'overlay ─────────────────────────────
# Fusionnées dans les catalogues amont (pas de .po surchargé, donc les
# traductions d'amc-webapp restent à jour lors d'un changement de révision).
COPY webapp/i18n/ /tmp/i18n/
RUN /venv/bin/python /tmp/i18n/merge_po.py /amc-web/server/translations /tmp/i18n \
    && rm -rf /tmp/i18n

ENV PATH=/venv/bin:$PATH
ENV FLASK_APP=amc
# Les projets AMC sont les dossiers montés (CONTROLES) — mêmes que la GUI
ENV AMC_PROJECTSDIR=/amc/controles
ENV AMC_TXT_DEFAULTFONT="Linux Libertine"
ENV AMC_TXT_DEFAULTFONT_ARABIC="DejaVu Sans"
# Mode mono-utilisateur local : pas d'authentification, pas d'isolation landrun
ENV AMC_ISOLATE=0

WORKDIR /amc-web
RUN make

WORKDIR /amc-web/server
RUN flask digest compile

# ── 5. Démarrage ─────────────────────────────────────────────
COPY entrypoint-webapp.sh /entrypoint-webapp.sh
RUN chmod +x /entrypoint-webapp.sh

EXPOSE 8080
ENTRYPOINT ["/entrypoint-webapp.sh"]
CMD ["gunicorn", "-k", "gevent", "-w", "1", "amc:app", "-b", "0.0.0.0:8080", "--preload", "--access-logfile", "-"]
