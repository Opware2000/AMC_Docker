# ============================================================
# Auto-Multiple-Choice — docker-compose pour Mac Apple Silicon
# ============================================================
# Prérequis : Xpra installé sur Mac (https://xpra.org/downloads/)
# Usage     : Copiez ce fichier en docker-compose.yml
#             Adaptez les chemins des volumes ci-dessous
#             puis lancez : ./launch-gtk.sh  (ou ./launch-web.sh)
# ============================================================

services:
  amc:
    build:
      context: .
      dockerfile: Dockerfile
    image: amc-nqcm:latest

    # Force arm64 natif (pas d'émulation x86 lente)
    platform: linux/arm64

    # ── Variables d'environnement ──────────────────────────
    environment:
      - LANG=fr_FR.UTF-8
      - LC_ALL=fr_FR.UTF-8

    # ── Port Xpra (client natif Mac) ──────────────────────
    ports:
      - "14500:14500"

    # ── Volumes — ADAPTEZ CES CHEMINS ─────────────────────
    volumes:
      # Classe LaTeX personnalisée nQCM (lecture seule)
      - /chemin/vers/nQcm:/nqcm:ro

      # Dossier nQcm — copier automultiplechoice.sty depuis le container
      - /chemin/vers/nQcm:/amc/latex

      # Dossier SCAN (lecture/écriture — AMC y écrit ses résultats)
      - /chemin/vers/SCAN:/amc/scan

      # Dossier CONTROLES contenant vos projets AMC (accès complet)
      - /chemin/vers/CONTROLES:/amc/controles

      # Dossiers montés directement à la racine du conteneur
      # (accès rapide + signets dans les dialogues Ouvrir/Enregistrer d'AMC)
      - /chemin/vers/CONTROLES/LISTES:/LISTES
      - /chemin/vers/CONTROLES/SCAN:/SCAN
      - /chemin/vers/CONTROLES/SUJETS:/SUJETS
      - /chemin/vers/QCM:/QCM

      # Données persistantes AMC (configuration, préférences)
      - amc-data:/root/.AMC.d

    # Permet d'éviter certains problèmes de rendu GTK/Cairo
    shm_size: '256mb'

    # ── Limites de ressources ──────────────────────────────
    deploy:
      resources:
        limits:
          cpus: '4'       # 4 cœurs max (ajustez selon votre Mac)
          memory: 2G      # 2 Go max (LaTeX + scans)
        reservations:
          cpus: '1'
          memory: 512M

    # Redémarre jamais automatiquement (c'est une appli GUI)
    restart: "no"

    # Profil de sécurité relâché pour X11
    security_opt:
      - seccomp:unconfined

  # ── Serveur web (navigateur) ────────────────────────────────
  # Optionnel, profil « webapp ». Nécessite l'image de base amc-nqcm:latest
  # (docker compose build amc, ou un premier ./launch-gtk.sh).
  #   docker compose --profile webapp up -d --build amc-web
  #   → http://localhost:8080
  amc-web:
    profiles: ["webapp"]
    build:
      context: .
      dockerfile: Dockerfile.webapp
    image: amc-nqcm-web:latest
    platform: linux/arm64

    # ── Port du serveur web ─────────────────────────────────
    ports:
      - "8080:8080"

    environment:
      - LANG=fr_FR.UTF-8
      - LC_ALL=fr_FR.UTF-8
      # Les projets AMC sont les dossiers de CONTROLES (mêmes que la GUI)
      - AMC_PROJECTSDIR=/amc/controles

    # Mêmes dossiers que le service `amc` (source unique : ce fichier)
    volumes:
      - /chemin/vers/nQcm:/nqcm:ro
      - /chemin/vers/CONTROLES:/amc/controles
      - amc-data:/root/.AMC.d

    shm_size: '256mb'
    restart: "no"

# ── Volumes nommés ─────────────────────────────────────────
volumes:
  amc-data:
    driver: local
    # Les projets AMC sont persistés entre les sessions
